{
  "name": "vue-croppa",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "A simple, polished, Vue-native image cropper for upload flows.",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/vue-croppa.cjs",
  "module": "./dist/vue-croppa.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue-croppa.js",
      "require": "./dist/vue-croppa.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
